module Cic #(
    param Width : u32 = 32,
    param Stages: u32 = 4 ,
    param N     : u32 = 2 ,
    param R     : u32 = 5 ,
) (
    i_d      : input     signed logic<Width>,
    o_d      : output    signed logic<Width>,
    o_clk_low: output '_ clock              ,
    i_clk    : input  '_ clock              ,
    i_rst    : input     reset              ,
) {
    const Expansion    : i32 = Stages * $clog2(N * R);
    const ExpandedWidth: i32 = Width + Expansion;

    // Integrator
    var integrator_d: signed logic<ExpandedWidth> [Stages + 1];

    assign integrator_d[0] = i_d as ExpandedWidth;

    for i in 1..Stages + 1 :integrators {
        inst integrator: Integrator #(
            Width: ExpandedWidth,
        ) (
            i_d  : integrator_d[i - 1],
            o_d  : integrator_d[i]    ,
            i_clk: i_clk              ,
            i_rst: i_rst              ,
        );
    }

    // Down sample
    var o_clk_en;

    inst counter: $std::counter #(
        WIDTH    : $clog2(R),
        MAX_COUNT: R - 1,
    ) (
        i_clk        : i_clk   ,
        i_rst        : i_rst   ,
        i_up         : 1       ,
        o_wrap_around: o_clk_en,
        i_clear      : 0       ,
        i_set        : 0       ,
        i_set_value  : 0       ,
        i_down       : 0       ,
        o_count      : _       ,
        o_count_next : _       ,
    );

    var down_sampled: signed logic<ExpandedWidth>;

    assign o_clk_low = i_clk & o_clk_en;

    always_ff (o_clk_low) {
        down_sampled = integrator_d[Stages];
    }

    // Comb
    var comb_d: signed logic<ExpandedWidth> [Stages + 1];

    assign comb_d[0] = down_sampled;

    for i in 1..Stages + 1 :combs {
        inst comb: Comb #(
            Width: ExpandedWidth,
            N    : N            ,
        ) (
            i_d  : comb_d[i - 1],
            o_d  : comb_d[i]    ,
            i_clk: o_clk_low    ,
            i_rst: i_rst        ,
        );
    }

    let o_comb: signed logic<Width> = (comb_d[Stages] >> Expansion) as Width;

    // Compensation Filter
    inst compensation_filter: Fir #(
        Width: Width,
        N    : 11   ,
        Bs   : '{
            32'b11111111100000100110111010010111, 32'b00000111000111101100100010100111,
            32'b11111101100111001001110110011010, 32'b11001110110101001010011110011111,
            32'b00011000101010101011010001011111, 32'b01111111111111111111111111111111,
            32'b00011000101010101011010001011111, 32'b11001110110101001010011110011111,
            32'b11111101100111001001110110011010, 32'b00000111000111101100100010100111,
            32'b11111111100000100110111010010111,
        },
    ) (
        i_d  : o_comb,
        o_d  : o_d   ,
        i_clk        ,
        i_rst        ,
    );
}

module Fir #(
    param Width: u32                     = 32     ,
    param N    : u32                     = 2      ,
    param Bs   : signed logic<Width> [N] = '{1, 1},
) (
    i_d  : input  signed logic<Width>,
    o_d  : output signed logic<Width>,
    i_clk: input  clock              ,
    i_rst: input  reset              ,
) {
    function Sum (
        xs: input signed logic<Width> [N],
    ) -> u32 {
        var sum: u32;

        for i in 0..N {
            if xs[i][msb] == 0 {
                sum = sum + xs[i] as u32;
            } else {
                sum = sum + (~xs[i] + 1) as u32;
            }
        }

        return sum;
    }

    const Expansion    : u32 = $clog2(Sum(Bs)) as u32;
    const ExpandedWidth: u32 = Width + Expansion;

    var tap_d: signed logic<ExpandedWidth> [N - 1];

    always_ff {
        for i in 0..N - 1 {
            if i == 0 {
                tap_d[i] = i_d as ExpandedWidth;
            } else {
                tap_d[i] = tap_d[i - 1];
            }
        }
    }

    var scaled_d: signed logic<ExpandedWidth> [N]    ;
    var sums    : signed logic<ExpandedWidth> [N - 1];

    always_comb {
        for i in 0..N {
            if i == 0 {
                scaled_d[i] = i_d as ExpandedWidth * Bs[i] as ExpandedWidth;
            } else {
                scaled_d[i] = tap_d[i - 1] * Bs[i] as ExpandedWidth;
            }
        }

        for i in 0..N - 1 {
            sums[i] = scaled_d[i] + scaled_d[i + 1];
        }
    }

    assign o_d = (sums[N - 2] >> Expansion) as Width;
}

module Integrator #(
    param Width: u32 = 32,
) (
    i_d  : input  signed logic<Width>,
    o_d  : output signed logic<Width>,
    i_clk: input  clock              ,
    i_rst: input  reset              ,
) {
    always_ff {
        o_d = o_d + i_d;
    }
}

module Comb #(
    param Width: u32 = 32,
    param N    : u32 = 2 ,
) (
    i_d  : input  signed logic<Width>,
    o_d  : output signed logic<Width>,
    i_clk: input  clock              ,
    i_rst: input  reset              ,
) {
    var delayed_in: signed logic<Width>;

    inst delay: $std::delay #(
        DELAY: N    ,
        WIDTH: Width,
    ) (
        i_d  : i_d       ,
        o_d  : delayed_in,
        i_clk: i_clk     ,
        i_rst: i_rst     ,
    );

    always_ff {
        o_d = i_d + delayed_in;
    }
}

#[test(test_cic)]
module test_cic {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var i_d      : signed logic<32>;
    var o_d      : signed logic<32>;
    var o_clk_low: logic           ;

    inst dut: Cic #(
        Width: 32,
    ) (
        i_d           ,
        o_d           ,
        o_clk_low     ,
        i_clk    : clk,
        i_rst    : rst,
    );

    inst data_gen: $comp::generator #(
        Width     : 32     ,
        Freq      : 100000 ,
        SampleRate: 4000000,
    ) (
        clk      ,
        rst      ,
        data: i_d,
    );

    initial {
        rst.assert();
        for _ in 0..1000 {
            clk.next();
        }
        $finish();
    }
}
