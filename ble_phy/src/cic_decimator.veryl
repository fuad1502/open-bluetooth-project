module Integrator #(
    param Width: u32 = 32,
) (
    i_d  : input  logic<Width>,
    o_d  : output logic<Width>,
    i_clk: input  clock       ,
    i_rst: input  reset       ,
) {
    always_ff {
        o_d = o_d + i_d;
    }
}

module Comb #(
    param Width: u32 = 32,
    param N    : u32 = 2 ,
) (
    i_d  : input  logic<Width>,
    o_d  : output logic<Width>,
    i_clk: input  clock       ,
    i_rst: input  reset       ,
) {
    var delayed_in;

    inst delay: $std::delay #(
        DELAY: N    ,
        WIDTH: Width,
    ) (
        i_d  : i_d       ,
        o_d  : delayed_in,
        i_clk: i_clk     ,
        i_rst: i_rst     ,
    );

    always_ff {
        o_d = i_d + delayed_in;
    }
}

module Cic #(
    param Width : u32 = 32,
    param Stages: u32 = 4 ,
    param N     : u32 = 2 ,
    param R     : u32 = 5 ,
) (
    i_d      : input     logic<Width>,
    o_d      : output    logic<Width>,
    o_clk_low: output '_ clock       ,
    i_clk    : input  '_ clock       ,
    i_rst    : input     reset       ,
) {
    // Integrator
    var integrator_d: logic<Width> [Stages + 1];

    assign integrator_d[0] = i_d;

    for i in 1..Stages + 1 :integrators {
        inst integrator: Integrator #(
            Width: Width,
        ) (
            i_d  : integrator_d[i - 1],
            o_d  : integrator_d[i]    ,
            i_clk: i_clk              ,
            i_rst: i_rst              ,
        );
    }

    // Down sample
    var o_clk_en;

    inst counter: $std::counter #(
        WIDTH    : Width,
        MAX_COUNT: R    ,
    ) (
        i_clk        : i_clk   ,
        i_rst        : i_rst   ,
        i_up         : 1       ,
        o_wrap_around: o_clk_en,
        i_clear      : 0       ,
        i_set        : 0       ,
        i_set_value  : 0       ,
        i_down       : 0       ,
        o_count      : _       ,
        o_count_next : _       ,
    );

    var down_sampled;

    assign o_clk_low = i_clk & o_clk_en;

    always_ff (o_clk_low) {
        down_sampled = integrator_d[Stages];
    }

    // Comb
    var comb_d: logic<Width> [Stages + 1];

    assign comb_d[0] = down_sampled;

    for i in 1..Stages + 1 :combs {
        inst comb: Comb #(
            Width: Width,
            N    : N    ,
        ) (
            i_d  : comb_d[i - 1],
            o_d  : comb_d[i]    ,
            i_clk: o_clk_low    ,
            i_rst: i_rst        ,
        );
    }

    assign o_d = comb_d[Stages];
}
