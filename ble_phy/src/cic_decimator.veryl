module Cic #(
    param Width : u32 = 32,
    param Stages: u32 = 4 ,
    param N     : u32 = 2 ,
    param R     : u32 = 5 ,
) (
    i_d     : input  signed logic<Width>,
    o_d     : output signed logic<Width>,
    o_clk_en: output logic              ,
    i_clk   : input  clock              ,
    i_rst   : input  reset              ,
) {
    const Expansion    : i32 = Stages * $clog2(N * R);
    const ExpandedWidth: i32 = Width + Expansion;

    // Integrator
    var integrator_d: signed logic<ExpandedWidth> [Stages + 1];

    assign integrator_d[0] = i_d as ExpandedWidth;

    for i in 1..Stages + 1 :integrators {
        inst integrator: Integrator #(
            Width: ExpandedWidth,
        ) (
            i_d  : integrator_d[i - 1],
            o_d  : integrator_d[i]    ,
            i_clk: i_clk              ,
            i_rst: i_rst              ,
        );
    }

    let o_integrator = integrator_d[Stages];

    // Down sample
    const CounterWidth  : u32                         = $clog2(R);
    var   counter       : logic       <CounterWidth> ;
    var   o_down_sampled: signed logic<ExpandedWidth>;

    always_ff {
        if counter == (R - 1) as CounterWidth {
            o_down_sampled = o_integrator;
            o_clk_en       = 1;
            counter        = 0;
        } else {
            o_clk_en =  0;
            counter  += 1;
        }
    }

    // Comb
    var comb_d: signed logic<ExpandedWidth> [Stages + 1];

    assign comb_d[0] = o_down_sampled;

    for i in 1..Stages + 1 :combs {
        inst comb: Comb #(
            Width: ExpandedWidth,
            N    : N            ,
        ) (
            i_d     : comb_d[i - 1],
            o_d     : comb_d[i]    ,
            i_clk_en: o_clk_en     ,
            i_clk                  ,
            i_rst                  ,
        );
    }

    let o_comb: signed logic<Width> = (comb_d[Stages] >>> Expansion) as Width;

    // Compensation Filter
    inst compensation_filter: Fir #(
        Width    : Width,
        Fractions: 27   ,
        N        : 31   ,
        Bs       : '{
            32'b00000000000000111110100011010111, 32'b11111111110000100101110110001110,
            32'b00000000000011010110110100000010, 32'b00000000011010010101101111111101,
            32'b11111111111101110110111111111010, 32'b11111111010000111000100011110110,
            32'b11111111001111101110110011000011, 32'b00000010011000011011000111100110,
            32'b00000010100110100011111111001011, 32'b11110111101011010101111011101000,
            32'b11111101000010001001110010100000, 32'b00010101001010001000101011110000,
            32'b11111100101111101110001001100111, 32'b11010110100011011110101011100010,
            32'b00010000010011111011011010110011, 32'b01001101010100110010010100111111,
            32'b00010000010011111011011010110011, 32'b11010110100011011110101011100010,
            32'b11111100101111101110001001100111, 32'b00010101001010001000101011110000,
            32'b11111101000010001001110010100000, 32'b11110111101011010101111011101000,
            32'b00000010100110100011111111001011, 32'b00000010011000011011000111100110,
            32'b11111111001111101110110011000011, 32'b11111111010000111000100011110110,
            32'b11111111111101110110111111111010, 32'b00000000011010010101101111111101,
            32'b00000000000011010110110100000010, 32'b11111111110000100101110110001110,
            32'b00000000000000111110100011010111,
        },
    ) (
        i_d     : o_comb  ,
        i_clk_en: o_clk_en,
        o_d               ,
        i_clk             ,
        i_rst             ,
    );
}

module Fir #(
    param Width    : u32                     = 32     ,
    param Fractions: u32                     = 27     ,
    param N        : u32                     = 2      ,
    param Bs       : signed logic<Width> [N] = '{1, 1},
) (
    i_d     : input  signed logic<Width>,
    o_d     : output signed logic<Width>,
    i_clk   : input  clock              ,
    i_clk_en: input  logic              ,
    i_rst   : input  reset              ,
) {
    const Expansion    : u32 = Width + $clog2(N); // TODO: Calculate expansion required from Bs
    const ExpandedWidth: u32 = Width + Expansion;

    var tap_d: signed logic<Width> [N - 1];

    always_ff {
        if i_clk_en {
            for i in 0..N - 1 {
                if i == 0 {
                    tap_d[i] = i_d;
                } else {
                    tap_d[i] = tap_d[i - 1];
                }
            }
        }
    }

    var scaled_d: signed logic<ExpandedWidth> [N];
    var sums    : signed logic<ExpandedWidth> [N];

    always_comb {
        for i in 0..N {
            if i == 0 {
                scaled_d[i] = (i_d as ExpandedWidth) * (Bs[i] as ExpandedWidth);
                sums[i]     = scaled_d[i];
            } else {
                scaled_d[i] = (tap_d[i - 1] as ExpandedWidth) * (Bs[i] as ExpandedWidth);
                sums[i]     = sums[i - 1] + scaled_d[i];
            }
        }
    }

    assign o_d = (sums[N - 1] >>> Fractions) as Width;
}

module Integrator #(
    param Width: u32 = 32,
) (
    i_d  : input  signed logic<Width>,
    o_d  : output signed logic<Width>,
    i_clk: input  clock              ,
    i_rst: input  reset              ,
) {
    always_ff {
        o_d = o_d + i_d;
    }
}

module Comb #(
    param Width: u32 = 32,
    param N    : u32 = 2 ,
) (
    i_d     : input  signed logic<Width>,
    o_d     : output signed logic<Width>,
    i_clk   : input  clock              ,
    i_clk_en: input  logic              ,
    i_rst   : input  reset              ,
) {
    var delayed: signed logic<Width> [N];

    always_ff {
        if i_clk_en {
            o_d = i_d - delayed[N - 1];
            for i in 0..N {
                if i == 0 {
                    delayed[i] = i_d;
                } else {
                    delayed[i] = delayed[i - 1];
                }
            }
        }
    }
}

#[test(test_cic)]
module test_cic {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var freq    : u64             ;
    var i_d     : signed logic<32>;
    var o_d     : signed logic<32>;
    var o_clk_en: logic           ;

    inst dut: Cic #(
        Width: 32,
    ) (
        i_d          ,
        o_d          ,
        o_clk_en     ,
        i_clk   : clk,
        i_rst   : rst,
    );

    inst data_gen: $comp::generator #(
        Width     : 32      ,
        SampleRate: 20000000,
    ) (
        clk      ,
        rst      ,
        freq     ,
        data: i_d,
    );

    inst analyzer: $comp::analyzer #(
        Width     : 32     ,
        SampleRate: 4000000,
    ) (
        clk             ,
        rst             ,
        clk_en: o_clk_en,
        data  : o_d     ,
    );

    initial {
        // Check 1 kHz
        freq = 1000;
        rst.assert();
        for _ in 0..(8192 * 5) {
            clk.next();
        }
        analyzer.check_loss(freq, 1, 1);

        // Check 100 kHz
        freq = 100000;
        rst.assert();
        for _ in 0..(8192 * 5) {
            clk.next();
        }
        analyzer.check_loss(freq, 1, 1);

        // Check 1 MHz
        freq = 1000000;
        rst.assert();
        for _ in 0..(8192 * 5) {
            clk.next();
        }
        analyzer.check_loss_less_than(freq, 3);

        // Check 1.5 MHz
        freq = 1500000;
        rst.assert();
        for _ in 0..(8192 * 5) {
            clk.next();
        }
        analyzer.check_loss_greater_than(freq, 60);

        $finish();
    }
}
