module BitDetector #(
    param Width              : u32                 = 32       ,
    param Fractions          : u32                 = 29       ,
    param PhaseErrorThreshold: signed logic<Width> = (1 << 28),
    param GardnerLoopKp      : signed logic<Width> = 1        ,
) (
    i_demod : input  signed logic<Width>,
    i_cfo   : input  signed logic<Width>,
    o_bit   : output logic              ,
    o_sample: output logic              ,
    i_clk   : input  clock              ,
    i_rst   : input  reset              ,
    i_clk_en: input  logic              ,
) {
    var cfo        : signed logic<Width>;
    var cfo_latched: logic              ;

    always_ff {
        if i_clk_en {
            if !cfo_latched {
                cfo         = i_cfo;
                cfo_latched = 1;
            }
        }
    }

    var demod_taps: signed logic<Width> [4];

    always_ff {
        if i_clk_en && cfo_latched {
            demod_taps[0] = i_demod - cfo;
            for i in 1..4 {
                demod_taps[i] = demod_taps[i - 1];
            }
        }
    }

    var sample_phase      : logic       <3>    ;
    var sample_phase_reset: logic       <3>    ;
    var phase_error_acc   : signed logic<Width>;

    type ExpandedType = signed logic<Width * 2>;

    let error       : ExpandedType        = (demod_taps[1] as ExpandedType
        * (i_demod as ExpandedType - demod_taps[3] as ExpandedType));
    let scaled_error: signed logic<Width> = (error >>> Fractions >>> GardnerLoopKp) as Width;

    always_ff {
        if i_clk_en && cfo_latched {
            if sample_phase == 0 {
                if phase_error_acc >: PhaseErrorThreshold {
                    sample_phase_reset = 2;
                    phase_error_acc    = scaled_error;
                } else if phase_error_acc <: -PhaseErrorThreshold {
                    sample_phase_reset = 4;
                    phase_error_acc    = scaled_error;
                } else {
                    sample_phase_reset =  3;
                    phase_error_acc    += scaled_error;
                }
                sample_phase += 1;
                o_sample     =  1;
                o_bit        =  i_demod >: 0;
            } else if sample_phase == sample_phase_reset {
                sample_phase = 0;
                o_sample     = 0;
            } else {
                sample_phase += 1;
                o_sample     =  0;
            }
        }
    }
}

#[test(bit_detector_test)]
module bit_detector_test {
    inst clk  : $tb::clock_gen;
    inst rst_0: $tb::reset_gen ( clk );
    inst rst_1: $tb::reset_gen ( clk );

    const width         : u32 = 32;
    const sps           : u32 = 4;
    const amplitude     : i32 = (1 << 29);
    const offset        : i32 = 30;
    const noise_db      : i32 = 60;
    const access_address: u32 = 32'h8E89BED6;

    var i_demod : signed logic<width>;
    var i_cfo   : signed logic<width>;
    var o_bit   : logic              ;
    var o_sample: logic              ;

    inst bit_detector: BitDetector #(
        Width              : width             ,
        Fractions          : width - 3,
        PhaseErrorThreshold: (1 << (width - 4)),
        GardnerLoopKp      : 2                 ,
    ) (
        i_demod        ,
        i_cfo          ,
        o_bit          ,
        o_sample       ,
        i_clk   : clk  ,
        i_rst   : rst_1,
        i_clk_en: 1    ,
    );

    var i_amplitude: signed logic<width>;
    var i_noise_db : signed logic<width>;
    var i_data     : u64                ;
    var i_data_en  : logic              ;

    inst symbol_generator: $comp::symbol_generator #(
        Width           : width                  ,
        Fractions       : width - 2,
        SamplesPerSymbol: sps                    ,
        BT              : (1 << (width - 2)) >> 1,
        SampleOffset    : (1 << (width - 2)) >> 1,
        FreqOffsetPpm   : 100                    ,
    ) (
        i_amplitude         ,
        i_offset   : i_cfo  ,
        i_noise_db          ,
        i_data              ,
        i_data_en           ,
        o_data     : i_demod,
        clk                 ,
        rst        : rst_0  ,
    );

    initial {
        rst_0.assert();
        i_cfo       = 10;
        i_amplitude = amplitude;
        i_noise_db  = noise_db;
        i_data      = {access_address, 'b01010101};
        i_data_en   = 1;

        clk.next();
        i_data_en = 0;

        // Gaussian filter delay
        for _ in 0..(sps * 3 / 2) {
            clk.next();
        }

        // Start processing
        rst_1.assert();
        clk.next();

        // Check: with no noise it's possible to stuck at inverted stable point
        for _ in 0..((32 + 8) * sps) {
            clk.next();
            $display("%d, %d: %d", bit_detector.sample_phase_reset, o_sample, bit_detector.i_demod);
        }
    }
}
