module BitDetector #(
    param Width              : u32                 = 32       ,
    param Fractions          : u32                 = 29       ,
    param PhaseErrorThreshold: signed logic<Width> = (1 << 28),
    param GardnerLoopKp      : signed logic<Width> = 1        ,
) (
    i_demod  : input  signed logic<Width>,
    i_cfo    : input  signed logic<Width>,
    i_process: input  logic              ,
    o_bit    : output logic              ,
    o_sample : output logic              ,
    i_clk    : input  clock              ,
    i_rst    : input  reset              ,
    i_clk_en : input  logic              ,
) {
    var cfo        : signed logic<Width>;
    var cfo_latched: logic              ;

    always_ff {
        if !i_process {
            cfo         = 0;
            cfo_latched = 0;
        } else if i_clk_en {
            if !cfo_latched {
                cfo         = i_cfo;
                cfo_latched = 1;
            }
        }
    }

    let detect_0 : signed logic<Width>     = i_demod - i_cfo;
    var detect_1 : signed logic<Width> [2];
    var detect_2 : signed logic<Width> [2];
    var detect_en: logic                  ;

    always_ff {
        if !i_process {
            detect_1[0] = 0;
            detect_1[1] = 0;
            detect_2[0] = 1;
            detect_2[1] = 0;
            detect_en   = 0;
        } else if i_clk_en {
            detect_1[0] = detect_0;
            detect_1[1] = detect_1[0];
            detect_2[0] = detect_1[1];
            detect_2[1] = detect_2[0];
            detect_en   = !detect_en;
        }
    }

    var sample_phase   : logic       <2>    ;
    var phase_error_acc: signed logic<Width>;

    type ExpandedType = signed logic<Width * 2>;
    let error       : ExpandedType            = (detect_1[1] as ExpandedType
        * (detect_0 as ExpandedType - detect_2[1] as ExpandedType));
    let scaled_error: signed logic<Width>     = (error >>> Fractions >>> GardnerLoopKp) as Width;

    always_ff {
        if !i_process {
            phase_error_acc = 0;
            sample_phase    = 0;
        } else if cfo_latched && detect_en {
            if phase_error_acc >: PhaseErrorThreshold {
                phase_error_acc =  phase_error_acc - PhaseErrorThreshold;
                sample_phase    += 2;
            } else if phase_error_acc <: -PhaseErrorThreshold {
                phase_error_acc = phase_error_acc + PhaseErrorThreshold;
            } else {
                phase_error_acc += scaled_error;
                sample_phase    += 1;
            }
        } else if i_clk_en {
            sample_phase += 1;
        }
    }

    always_ff {
        if !i_process {
            o_sample = 0;
            o_bit    = 0;
        } else if cfo_latched && i_clk_en {
            if sample_phase == 0 && !o_sample {
                o_sample = 1;
                o_bit    = detect_0 >: 0;
            } else if sample_phase == 3 && phase_error_acc >: PhaseErrorThreshold {
                o_sample = 1;
                o_bit    = detect_0 >: 0;
            } else {
                o_sample = 0;
            }
        }
    }
}

#[test(bit_detector_test)]
module bit_detector_test {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    const width         : u32 = 32;
    const sps           : u32 = 4;
    const amplitude     : i32 = (1 << 29);
    const offset        : i32 = 30;
    const access_address: u32 = 32'h8E89BED6;

    var i_demod  : signed logic<width>;
    var i_cfo    : signed logic<width>;
    var i_process: logic              ;
    var o_bit    : logic              ;
    var o_sample : logic              ;

    inst bit_detector: BitDetector (
        i_demod       ,
        i_cfo         ,
        i_process     ,
        o_bit         ,
        o_sample      ,
        i_clk    : clk,
        i_rst    : rst,
        i_clk_en : 1  ,
    );

    var i_amplitude: signed logic<width>;
    var i_data     : u64                ;
    var i_data_en  : logic              ;

    inst symbol_generator: $comp::symbol_generator #(
        Width           : width,
        SamplesPerSymbol: sps  ,
        InverseBT       : 2    ,
    ) (
        i_amplitude         ,
        i_offset   : i_cfo  ,
        i_data              ,
        i_data_en           ,
        o_data     : i_demod,
        clk                 ,
        rst                 ,
    );

    initial {
        rst.assert();
        i_cfo       = 10;
        i_process   = 0;
        i_amplitude = amplitude;
        i_data      = {access_address, 8'b10101010};
        i_data_en   = 1;

        clk.next();
        i_data_en = 0;

        // Gaussian filter delay
        for _ in 0..(sps * 3 / 2) {
            clk.next();
        }

        // Start processing
        i_process = 1;
        clk.next();

        // Check: with no noise it's possible to stuck at inverted stable point
        for _ in 0..((32 + 8) * sps) {
            clk.next();
            if o_sample {
                $display("%d", o_bit);
            }
        }
    }
}
