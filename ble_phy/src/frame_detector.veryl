module FrameDetector #(
    param Width               : u32                 = 32,
    param AAMatchThreshold    : signed logic<Width> = 0 ,
    param IQMagnitudeThreshold: signed logic<Width> = 0 ,
) (
    i_demod   : input  signed logic<Width>               ,
    i_mag     : input  signed logic<Width>               ,
    i_aa      : input  logic       <32>    = 32'h8E89BED6,
    o_demod   : output signed logic<Width>               ,
    o_aa_match: output logic                             ,
    o_cfo     : output signed logic<Width>               ,
    i_clk     : input  clock                             ,
    i_rst     : input  reset                             ,
    i_clk_en  : input  logic                             ,
) {
    inst delay_line_0: Delay #(
        D: 32 * 4 + 6 * 4,
    ) (
        i_d     : i_demod,
        o_d     : o_demod,
        i_clk            ,
        i_rst            ,
        i_clk_en         ,
    );

    var mag_avg: signed logic<Width>;

    inst iq_mag_average: IQMagnitudeAverager (
        i_mag   : i_mag  ,
        o_mag   : mag_avg,
        i_clk            ,
        i_rst            ,
        i_clk_en         ,
    );

    var cfo        : signed logic<Width>;
    var cfo_delayed: signed logic<Width>;

    inst cfo_estimator: CFOEstimator (
        i_demod      ,
        o_cfo   : cfo,
        i_clk        ,
        i_rst        ,
        i_clk_en     ,
    );

    inst delay_line_1: Delay #(
        D: 32 * 4,
    ) (
        i_d     : cfo        ,
        o_d     : cfo_delayed,
        i_clk                ,
        i_rst                ,
        i_clk_en             ,
    );

    var corr: signed logic<Width>;

    inst correlator: AccessAddressCorrelator (
        i_aa          ,
        i_demod       ,
        o_corr  : corr,
        i_clk         ,
        i_rst         ,
        i_clk_en      ,
    );

    assign o_aa_match = corr >: AAMatchThreshold && mag_avg >: IQMagnitudeThreshold;
    assign o_cfo      = cfo_delayed;
}

module IQMagnitudeAverager #(
    param Width: u32 = 32,
    // TODO: Determine fractions automatically
    param Fractions: u32 = 30    ,
    param N        : u32 = 32 * 4,
    // TODO: Calculate B from above parameters (1 / N * (2 ** Fractions))
    param B: signed logic<Width> = 32'b00000000100000000000000000000000,
) (
    i_mag   : input  signed logic<Width>,
    o_mag   : output signed logic<Width>,
    i_clk   : input  clock              ,
    i_rst   : input  reset              ,
    i_clk_en: input  logic              ,
) {
    // TODO: Use 1'b1 as coefficients and scale in the end
    inst moving_avg_filt: Fir #(
        Width                   ,
        Fractions               ,
        N                       ,
        Bs       : '{B repeat N},
    ) (
        i_d     : i_mag,
        o_d     : o_mag,
        i_clk          ,
        i_clk_en       ,
        i_rst          ,
    );
}

module CFOEstimator #(
    param Width: u32 = 32,
    // TODO: Determine fractions automatically
    param Fractions: u32 = 30   ,
    param CfoLen   : u32 = 6 * 4,
    // TODO: Calculate B from above parameters (1 / CfoLen * (2 ** Fractions))
    param B: signed logic<Width> = 32'b00000010101010101010101010101010,
) (
    i_demod : input  logic<Width>,
    o_cfo   : output logic<Width>,
    i_clk   : input  clock       ,
    i_rst   : input  reset       ,
    i_clk_en: input  logic       ,
) {
    // TODO: Use 1'b1 as coefficients and scale in the end
    inst moving_avg_filt: Fir #(
        Width                        ,
        Fractions                    ,
        N        : CfoLen            ,
        Bs       : '{B repeat CfoLen},
    ) (
        i_d     : i_demod,
        o_d     : o_cfo  ,
        i_clk            ,
        i_clk_en         ,
        i_rst            ,
    );
}

module AccessAddressCorrelator #(
    param Width: u32 = 32,
    // TODO: Determine fractions automatically
    param Fractions: u32 = 29,
) (
    i_aa    : input  logic       <32>   ,
    i_demod : input  signed logic<Width>,
    o_corr  : output signed logic<Width>,
    i_clk   : input  clock              ,
    i_rst   : input  reset              ,
    i_clk_en: input  logic              ,
) {
    /* Calculate AA bits sum */
    var aa_bits_sum_d: signed logic<$clog2(32)> [32];
    var aa_bits_sum  : signed logic<$clog2(32)>     ;

    always_comb {
        for i in 0..32 {
            if i == 0 {
                if i_aa[i] == 0 {
                    aa_bits_sum_d[i] = -1 as ($clog2(32));
                } else {
                    aa_bits_sum_d[i] = 1 as ($clog2(32));
                }
            } else {
                if i_aa[i] == 0 {
                    aa_bits_sum_d[i] = aa_bits_sum_d[i - 1] - 1 as ($clog2(32));
                } else {
                    aa_bits_sum_d[i] = aa_bits_sum_d[i - 1] + 1 as ($clog2(32));
                }
            }
        }
    }

    assign aa_bits_sum = aa_bits_sum_d[31];
    let aa_bits_avg: signed logic<Width> = aa_bits_sum <<< Fractions >>> $clog2(32);

    /* Calculate AA bits */
    var aa_bits: signed logic<Width> [32 * 4];

    always_comb {
        let neg1: signed logic<Width> = ((-1 << Fractions) - aa_bits_avg) >>> $clog2(32 * 4);
        let pos1: signed logic<Width> = ((1 << Fractions) - aa_bits_avg) >>> $clog2(32 * 4);

        for i in 0..32 {
            if i_aa[31 - i] == 0 {
                aa_bits[4 * i + 0] = neg1;
                aa_bits[4 * i + 1] = neg1;
                aa_bits[4 * i + 2] = neg1;
                aa_bits[4 * i + 3] = neg1;
            } else {
                aa_bits[4 * i + 0] = pos1;
                aa_bits[4 * i + 1] = pos1;
                aa_bits[4 * i + 2] = pos1;
                aa_bits[4 * i + 3] = pos1;
            }
        }
    }

    /* Calculate correlation */
    inst correlator: FirGeneric #(
        Width            ,
        Fractions        ,
        N        : 32 * 4,
    ) (
        i_d     : i_demod,
        bs      : aa_bits,
        o_d     : o_corr ,
        i_clk            ,
        i_clk_en         ,
        i_rst            ,
    );
}

#[test(frame_detector_test)]
module frame_detector_test {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    const width         : u32 = 32;
    const sps           : u32 = 4;
    const amplitude     : i32 = 100;
    const magnitude     : i32 = 50;
    const offset        : i32 = 30;
    const access_address: u32 = 32'h8E89BED6;

    var i_demod   : signed logic<width>;
    var i_mag     : signed logic<width>;
    var o_demod   : signed logic<width>;
    var o_aa_match: logic              ;
    var o_cfo     : signed logic<width>;

    inst frame_detector: FrameDetector #(
        AAMatchThreshold    : amplitude - 10,
        IQMagnitudeThreshold: magnitude - 1,
    ) (
        i_demod        ,
        i_mag          ,
        o_demod        ,
        o_aa_match     ,
        o_cfo          ,
        i_clk     : clk,
        i_rst     : rst,
        i_clk_en  : 1  ,
    );

    var i_amplitude: signed logic<width>;
    var i_offset   : signed logic<width>;
    var i_data     : u64                ;
    var i_data_en  : logic              ;

    inst symbol_generator: $comp::symbol_generator #(
        Width           : width,
        SamplesPerSymbol: sps  ,
        InverseBT       : 2    ,
    ) (
        i_amplitude         ,
        i_offset            ,
        i_data              ,
        i_data_en           ,
        o_data     : i_demod,
        clk                 ,
        rst                 ,
    );

    initial {
        rst.assert();
        i_mag       = magnitude;
        i_amplitude = amplitude;
        i_offset    = offset;
        i_data      = {access_address, 8'b10101010};
        i_data_en   = 1;

        clk.next();
        i_data_en = 0;

        // Gaussian filter delay
        for _ in 0..(sps * 3 / 2) {
            clk.next();
        }

        $assert(!o_aa_match);

        // Shift preamble & access address
        for _ in 0..(sps * (32 + 8)) {
            clk.next();
        }

        $assert(o_cfo <= offset + 1);
        $assert(o_cfo >= offset - 1);
        $assert(frame_detector.corr <= amplitude + 10);
        $assert(frame_detector.corr >= amplitude - 10);
        $assert(o_aa_match);

        // Shift 6/8 preamble
        for _ in 0..3 {
            clk.next();
            clk.next();
            $assert(o_demod <: offset);
            clk.next();
            $assert(o_demod <: offset);
            clk.next();

            clk.next();
            clk.next();
            $assert(o_demod >: offset);
            clk.next();
            $assert(o_demod >: offset);
            clk.next();
        }

        // Shift access address
        for i in 0..32 {
            clk.next();
            clk.next();
            if access_address[i] {
                $assert(o_demod >: offset);
            } else {
                $assert(o_demod <: offset);
            }
            clk.next();
            if access_address[i] {
                $assert(o_demod >: offset);
            } else {
                $assert(o_demod <: offset);
            }
            clk.next();
        }
    }
}
