module GmskDemodulator #(
    param Width: u32 = 32,
    param Delay: u32 = 2 ,
) (
    i_inphase   : input  signed logic<Width>,
    i_quadrature: input  signed logic<Width>,
    o_freq      : output signed logic<Width>,
    o_mag       : output signed logic<Width>,
    i_clk       : input  clock              ,
    i_rst       : input  reset              ,
    i_clk_en    : input  logic              ,
) {
    var inphase_delayed   : signed logic<Width> [Delay];
    var quadrature_delayed: signed logic<Width> [Delay];

    always_ff {
        if i_clk_en {
            for i in 0..Delay {
                if i == 0 {
                    inphase_delayed[i]    = i_inphase;
                    quadrature_delayed[i] = i_quadrature;
                } else {
                    inphase_delayed[i]    = inphase_delayed[i - 1];
                    quadrature_delayed[i] = quadrature_delayed[i - 1];
                }
            }
        }
    }

    // TODO: Check if this is enough
    const ExpandedWidth: u32 = Width
        * 2;

    /* Conjugate multiply
    * a + jb
    * c - jd
    * real = a * c + b * d
    * imag = b * c - a * d
    */
    let conj_multiplied_real: signed logic<ExpandedWidth> = i_inphase as ExpandedWidth
        * inphase_delayed[Delay - 1] as ExpandedWidth + i_quadrature as ExpandedWidth
        * quadrature_delayed[Delay - 1] as ExpandedWidth;
    let conj_multiplied_imag: signed logic<ExpandedWidth> = i_quadrature as ExpandedWidth
        * inphase_delayed[Delay - 1] as ExpandedWidth - i_inphase as ExpandedWidth
        * quadrature_delayed[Delay - 1] as ExpandedWidth;

    /* Max deviation = 0.48 * PI */
    inst atan: Atan (
        i_y     : (conj_multiplied_imag >>> Width) as Width,
        i_x     : (conj_multiplied_real >>> Width) as Width,
        o_phase : o_freq                                   ,
        o_mag                                              ,
        i_clk                                              ,
        i_rst                                              ,
        i_clk_en                                           ,
    );
}

module Atan #(
    param Width    : u32                     = 32                                  ,
    param N        : u32                     = 32                                  ,
    param MagScale : signed logic<Width>     = 32'b00100110110111000101110101100011, // 0.607
    param Fractions: u32                     = 30                                  ,
    param LUT      : signed logic<Width> [N] = '{
        32'b00001010101010101010101010101011, 32'b01000010101010101010101010101010,
        32'b00100111010110110000101010101000, 32'b00010100110010110110000000010100,
        32'b00001010100011100011101001111010, 32'b00000101010011000101101110100001,
        32'b00000010101001101101011100010101, 32'b00000001010100111000000010111111,
        32'b00000000101010011100001100000111, 32'b00000000010101001110000111011000,
        32'b00000000001010100111000011110111, 32'b00000000000101010011100001111101,
        32'b00000000000010101001110000111111, 32'b00000000000001010100111000011111,
        32'b00000000000000101010011100010000, 32'b00000000000000010101001110001000,
        32'b00000000000000001010100111000100, 32'b00000000000000000101010011100010,
        32'b00000000000000000010101001110001, 32'b00000000000000000001010100111000,
        32'b00000000000000000000101010011100, 32'b00000000000000000000010101001110,
        32'b00000000000000000000001010100111, 32'b00000000000000000000000101010100,
        32'b00000000000000000000000010101010, 32'b00000000000000000000000001010101,
        32'b00000000000000000000000000101010, 32'b00000000000000000000000000010101,
        32'b00000000000000000000000000001011, 32'b00000000000000000000000000000101,
        32'b00000000000000000000000000000011, 32'b00000000000000000000000000000001,
    },
) (
    i_y     : input  signed logic<Width>,
    i_x     : input  signed logic<Width>,
    o_phase : output signed logic<Width>,
    o_mag   : output signed logic<Width>,
    i_clk   : input  clock              ,
    i_rst   : input  reset              ,
    i_clk_en: input  logic              ,
) {
    var yr   : signed logic<Width + 2> [N];
    var xr   : signed logic<Width + 2> [N];
    var angle: signed logic<Width>     [N];

    always_ff {
        if i_clk_en {
            if i_x[msb] == 1 && i_y[msb] == 1 {
                xr[0]    = -i_x as (Width + 2);
                yr[0]    = -i_y as (Width + 2);
                angle[0] = -LUT[0];
            } else if i_x[msb] == 1 && i_y[msb] != 1 {
                xr[0]    = -i_x as (Width + 2);
                yr[0]    = -i_y as (Width + 2);
                angle[0] = LUT[0];
            } else {
                xr[0]    = i_x as (Width + 2);
                yr[0]    = i_y as (Width + 2);
                angle[0] = 0;
            }
            for i in 1..N {
                if yr[i - 1][msb] == 1 {
                    xr[i]    = xr[i - 1] - (yr[i - 1] >>> (i - 1));
                    yr[i]    = yr[i - 1] + (xr[i - 1] >>> (i - 1));
                    angle[i] = angle[i - 1] - LUT[i];
                } else {
                    xr[i]    = xr[i - 1] + (yr[i - 1] >>> (i - 1));
                    yr[i]    = yr[i - 1] - (xr[i - 1] >>> (i - 1));
                    angle[i] = angle[i - 1] + LUT[i];
                }
            }
        }
    }

    assign o_phase = angle[N - 1];
    assign o_mag   = ((xr[N - 1] as (Width * 2) * MagScale as (Width * 2)) >> Fractions) as Width;
}

#[test(test_atan)]
module test_atan {
    // TODO: Remove this component! Change to Atan verification model.
    var utils: $comp::utils::<32>;

    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var i_y        : signed logic<32>;
    var i_x        : signed logic<32>;
    var o_phase    : signed logic<32>;
    var o_mag      : signed logic<32>;
    var o_phase_pos: signed logic<32>;

    inst atan: Atan (
        i_y          ,
        i_x          ,
        o_phase      ,
        o_mag        ,
        i_clk   : clk,
        i_rst   : rst,
        i_clk_en: 1  ,
    );

    initial {
        // 45 degree
        i_y = 100;
        i_x = 100;
        rst.assert();
        for _ in 0..32 {
            clk.next();
        }
        $assert(utils.convert_degree(o_phase) <= 46);
        $assert(utils.convert_degree(o_phase) >= 44);
        $assert(o_mag <= 143);
        $assert(o_mag >= 139);

        // -45 degree
        i_y = -100;
        i_x = 100;
        rst.assert();
        for _ in 0..32 {
            clk.next();
        }
        o_phase_pos = -o_phase;
        $assert(utils.convert_degree(o_phase_pos) <= 46);
        $assert(utils.convert_degree(o_phase_pos) >= 44);
        $assert(o_mag <= 143);
        $assert(o_mag >= 139);

        // 25 degree
        i_y = 4663;
        i_x = 10000;
        rst.assert();
        for _ in 0..32 {
            clk.next();
        }
        $assert(utils.convert_degree(o_phase) <= 26);
        $assert(utils.convert_degree(o_phase) >= 24);
        $assert(o_mag <= 11035);
        $assert(o_mag >= 11031);

        // -25 degree
        i_y = -4663;
        i_x = 10000;
        rst.assert();
        for _ in 0..32 {
            clk.next();
        }
        o_phase_pos = -o_phase;
        $assert(utils.convert_degree(o_phase_pos) <= 26);
        $assert(utils.convert_degree(o_phase_pos) >= 24);
        $assert(o_mag <= 11044);
        $assert(o_mag >= 11022);
    }
}

#[test(test_demod)]
module test_demod {
    // TODO: Remove this component! Change to Demod verification model.
    var utils: $comp::utils::<32>;

    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var freq: signed logic<32>;
    var o_i : signed logic<32>;
    var o_q : signed logic<32>;

    inst fm_modulator: $comp::fm_modulator #( Width: 32, SampleRate: 4000000 ) ( clk, rst, freq, o_i, o_q );

    var o_freq    : signed logic<32>;
    var o_freq_pos: signed logic<32>;
    var o_mag     : signed logic<32>;

    inst demod: GmskDemodulator (
        i_inphase   : o_i   ,
        i_quadrature: o_q   ,
        o_freq      : o_freq,
        o_mag               ,
        i_clk       : clk   ,
        i_rst       : rst   ,
        i_clk_en    : 1     ,
    );

    initial {
        // 400 kHz
        // -> 2 * PI * F / Fs * D = 72
        freq = 400000;
        rst.assert();
        for _ in 0..(32 + 3) {
            clk.next();
        }
        $assert(utils.convert_degree(o_freq) <= 73);
        $assert(utils.convert_degree(o_freq) >= 71);
        $assert(o_mag <= 1073800000);
        $assert(o_mag >= 1073600000);

        // -400 kHz
        // -> 2 * PI * F / Fs * D = -72
        freq = -400000;

        rst.assert();
        for _ in 0..(32 + 3) {
            clk.next();
        }
        o_freq_pos = -o_freq;
        $assert(utils.convert_degree(o_freq_pos) <= 74);
        $assert(utils.convert_degree(o_freq_pos) >= 70);
        $assert(o_mag <= 1073800000);
        $assert(o_mag >= 1073600000);

        // 50 kHz
        // -> 2 * PI * F / Fs * D = 9
        freq = 50000;
        rst.assert();
        for _ in 0..(32 + 3) {
            clk.next();
        }
        $assert(utils.convert_degree(o_freq) <= 10);
        $assert(utils.convert_degree(o_freq) >= 8);
        $assert(o_mag <= 1073800000);
        $assert(o_mag >= 1073600000);

        // -50 kHz
        // -> 2 * PI * F / Fs * D = -9
        freq = -50000;
        rst.assert();
        for _ in 0..(32 + 3) {
            clk.next();
        }
        o_freq_pos = -o_freq;
        $assert(utils.convert_degree(o_freq_pos) <= 11);
        $assert(utils.convert_degree(o_freq_pos) >= 7);
        $assert(o_mag <= 1073800000);
        $assert(o_mag >= 1073600000);
    }
}
