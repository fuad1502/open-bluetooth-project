module GmskDemodulator #(
    param Width: u32 = 32,
) (
    i_inphase   : input  logic<Width>,
    i_quadrature: input  logic<Width>,
    o_freq      : output logic<Width>,
    i_clk       : input  clock       ,
    i_rst       : input  reset       ,
    i_clk_en    : input  logic       ,
) {
    var inphase_delayed   ;
    var quadrature_delayed;

    always_ff {
        if i_clk_en {
            inphase_delayed    = i_inphase;
            quadrature_delayed = i_quadrature;
        }
    }

    let conj_multiplied_real: logic<Width> = i_inphase * inphase_delayed - i_quadrature * quadrature_delayed;
    let conj_multiplied_imag: logic<Width> = i_inphase * quadrature_delayed + i_quadrature * inphase_delayed;

    inst atan: Atan #(
        Width  ,
    ) (
        i_y    : conj_multiplied_imag,
        i_x    : conj_multiplied_real,
        o_phase: o_freq              ,
        i_clk                        ,
        i_rst                        ,
    );
}

module Atan #(
    param Width: u32                     = 32     ,
    param N    : u32                     = 2      ,
    param LUT  : signed logic<Width> [N] = '{1, 1},
) (
    i_y    : input  signed logic<Width>,
    i_x    : input  signed logic<Width>,
    o_phase: output signed logic<Width>,
    i_clk  : input  clock              ,
    i_rst  : input  reset              ,
) {
    var yr   : signed logic<Width + 2> [N];
    var xr   : signed logic<Width + 2> [N];
    var angle: signed logic<Width>     [N];

    always_ff {
        if i_x[msb] == 1 && i_y[msb] == 1 {
            xr[0]    = -i_x;
            yr[0]    = -i_y;
            angle[0] = -LUT[0];
        } else if i_x[msb] == 1 && i_y[msb] != 1 {
            xr[0]    = -i_x;
            yr[0]    = -i_y;
            angle[0] = LUT[0];
        } else {
            xr[0]    = i_x;
            yr[0]    = i_y;
            angle[0] = 0;
        }
        for i in 1..N {
            if yr[i - 1][msb] == 1 {
                xr[i]    = xr[i - 1] - (yr[i - 1] >>> (i - 1));
                yr[i]    = yr[i - 1] + (xr[i - 1] >>> (i - 1));
                angle[i] = angle[i - 1] - LUT[i];
            } else {
                xr[i]    = xr[i - 1] + (yr[i - 1] >>> (i - 1));
                yr[i]    = yr[i - 1] - (xr[i - 1] >>> (i - 1));
                angle[i] = angle[i - 1] + LUT[i];
            }
        }
    }

    assign o_phase = angle[N - 1];
}
